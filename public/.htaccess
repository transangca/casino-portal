# Chuyen moi request ve public/index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Khong rewrite file/thu muc ton tai
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Chan truy cap truc tiep vao thu muc app/ config/ database/ storage/
    RewriteRule ^(app|config|database|storage)/ - [F,L]

    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Chan xem file nguon
<FilesMatch "\.(env|log|json|lock|sql)$">
    Require all denied
</FilesMatch>

Options -Indexes
DirectoryIndex index.php
